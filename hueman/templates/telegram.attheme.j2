{#- Generado desde la paleta activa por hueman (target telegram_theme).
    Requiere palette_key: polybar y extra_vars: bg0h, bg2, blu, pur, aqu (kitty).
    fg2 y dim no son variables de entrada: se derivan de `foreground` y `muted`
    para no depender de secciones de otras herramientas (p. ej. `pi`). -#}
{%- macro argb(hex, a=255) -%}
{%- set h = hex.lstrip('#') -%}
{%- set v = a * 16777216 + (h[0:2] | int(base=16)) * 65536 + (h[2:4] | int(base=16)) * 256 + (h[4:6] | int(base=16)) -%}
{{ v - 4294967296 if v >= 2147483648 else v }}
{%- endmacro -%}
{%- set P = {
  'bg0h': bg0h, 'bg0': background, 'bg1': background_alt, 'bg2': bg2, 'bg3': muted,
  'fg': foreground, 'fg2': foreground, 'muted': muted, 'dim': muted,
  'yel': primary, 'org': secondary, 'blu': blu, 'grn': success, 'red': alert,
  'pur': pur, 'aqu': aqu
} -%}
