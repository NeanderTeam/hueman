{%- macro rgba(hex, a) -%}
rgba({{ hex[1:3] | int(base=16) }}, {{ hex[3:5] | int(base=16) }}, {{ hex[5:7] | int(base=16) }}, {{ a }})
{%- endmacro -%}
:root {
    /* Generado por hueman ({{ theme_name }}). No editar a mano este bloque. */
    --yasb-bar-bg: {{ background }};
    --yasb-surface-alt: {{ background_alt }};
    --yasb-bar-border: {{ border_inactive }};
    --yasb-popup-bg: {{ rgba(background, 0.95) }};
    --yasb-dialog-bg: {{ background_alt }};
    --yasb-dialog-surface: {{ background }};
{%- for n in ['03', '04', '05', '06', '07', '08', '10', '15', '20', '30', '40', '70', '80', '85'] %}
    --yasb-white-alpha-{{ n }}: {{ rgba(foreground, (n | int) / 100) }};
{%- endfor %}
    --yasb-fg: {{ foreground }};
    --yasb-fg-muted: {{ muted }};
    --yasb-icon-fg: {{ secondary }};
    --yasb-tooltip-bg: {{ rgba(background_alt, 0.97) }};
    --yasb-tooltip-border: {{ border_inactive }};
    --yasb-accent: {{ primary }};
    --yasb-accent-hover: {{ secondary }};
    --yasb-accent-fg: {{ primary | contrast }};
    --hueman-border: {{ border_inactive }};
    --hueman-border-active: {{ border_active }};
    --icons-font: "Segoe Fluent Icons";
    --icons-font-fallback: "JetBrainsMono NFP", "JetBrainsMono Nerd Font Propo";
    --system-font: "Segoe UI Variable", "Segoe UI";
}
{#- Sin salto final: el bloque se reemplaza in situ y no debe sumar lineas en cada `set`. -#}
